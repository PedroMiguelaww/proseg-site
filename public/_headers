# https://developers.cloudflare.com/workers/static-assets/headers
# Arquivos do site que mudam de nome a cada versão: o navegador pode guardar por 1 ano
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Imagens da pasta public (mantêm o nome): guardar por 1 dia
/images/*
  Cache-Control: public,max-age=86400
